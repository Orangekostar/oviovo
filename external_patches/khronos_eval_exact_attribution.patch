+++ b/khronos_eval/include/khronos_eval/exact_attribution.h
@@ -0,0 +1,142 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <optional>
+#include <sstream>
+#include <string>
