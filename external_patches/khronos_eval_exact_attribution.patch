+#include <khronos/common/common_types.h>
+
+namespace khronos::exact_attribution {
+
+struct Event {
+  std::string metric_type;
+  std::string map_name;
+  size_t metric_row_ordinal;
+  uint64_t query_time_ns;
+  uint64_t trajectory_timestamp_ns;
+  std::optional<NodeId> pred_node_id;
+  std::optional<NodeId> gt_node_id;
+  std::optional<double> distance_m;
+  std::string status;
+};
+
+inline bool openFromEnvironment(const std::string& filename, std::ofstream& stream) {
+  const char* output_dir = std::getenv("KHRONOS_EXACT_ATTRIBUTION_DIR");
+  if (!output_dir || std::string(output_dir).empty()) {
+    return true;
+  }
+  std::error_code error;
+  std::filesystem::create_directories(output_dir, error);
+  if (error) {
+    return false;
+  }
+  stream.open(std::filesystem::path(output_dir) / filename, std::ios::out | std::ios::trunc);
+  return stream.is_open();
+}
+
+inline void writeQuoted(std::ostream& stream, const std::string& value) {
+  stream << '"';
+  for (const unsigned char character : value) {
+    switch (character) {
+      case '"':
+        stream << "\\\"";
+        break;
+      case '\\':
+        stream << "\\\\";
+        break;
+      case '\b':
+        stream << "\\b";
+        break;
+      case '\f':
+        stream << "\\f";
+        break;
+      case '\n':
+        stream << "\\n";
+        break;
+      case '\r':
+        stream << "\\r";
+        break;
+      case '\t':
+        stream << "\\t";
+        break;
+      default:
+        if (character < 0x20) {
+          stream << "\\u00" << std::hex << std::setw(2) << std::setfill('0')
+                 << static_cast<int>(character) << std::dec << std::setfill(' ');
+        } else {
+          stream << character;
+        }
+    }
+  }
+  stream << '"';
+}
+
+inline std::string nodeName(const NodeId id) {
+  std::stringstream stream;
+  stream << NodeSymbol(id);
+  return stream.str();
+}
+
+inline void sortEvents(std::vector<Event>& events) {
+  std::sort(events.begin(), events.end(), [](const Event& lhs, const Event& rhs) {
+    return std::tie(lhs.metric_type,
+                    lhs.status,
+                    lhs.trajectory_timestamp_ns,
+                    lhs.pred_node_id,
+                    lhs.gt_node_id) <
+           std::tie(rhs.metric_type,
+                    rhs.status,
+                    rhs.trajectory_timestamp_ns,
+                    rhs.pred_node_id,
+                    rhs.gt_node_id);
+  });
+}
+
+inline void writeEvent(std::ostream& stream, const Event& event) {
+  stream << "{\"schema_version\":1,\"metric_type\":";
+  writeQuoted(stream, event.metric_type);
+  stream << ",\"map_name\":";
+  writeQuoted(stream, event.map_name);
+  stream << ",\"metric_row_ordinal\":" << event.metric_row_ordinal
+         << ",\"query_time_ns\":" << event.query_time_ns
+         << ",\"trajectory_timestamp_ns\":" << event.trajectory_timestamp_ns
+         << ",\"pred_node_id\":";
+  if (event.pred_node_id) {
+    writeQuoted(stream, nodeName(*event.pred_node_id));
+  } else {
+    stream << "null";
+  }
+  stream << ",\"gt_node_id\":";
+  if (event.gt_node_id) {
+    writeQuoted(stream, nodeName(*event.gt_node_id));
+  } else {
+    stream << "null";
+  }
+  stream << ",\"distance_m\":";
+  if (event.distance_m) {
+    stream << std::setprecision(17) << *event.distance_m;
+  } else {
+    stream << "null";
+  }
+  stream << ",\"status\":";
+  writeQuoted(stream, event.status);
+  stream << "}\n";
+}
+
+inline void writeEvents(std::ostream& stream, std::vector<Event> events) {
+  sortEvents(events);
+  for (const auto& event : events) {
+    writeEvent(stream, event);
+  }
+  stream.flush();
+}
+
+}  // namespace khronos::exact_attribution
