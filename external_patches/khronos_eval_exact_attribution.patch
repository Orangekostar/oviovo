+void DynamicObjectEvaluator::writeExactAttribution(const std::string& name,
+                                                   const uint64_t query_time,
+                                                   const DetectionMetrics& detections) {
+  const size_t row_ordinal = metric_row_ordinal_++;
+  if (!attribution_file_.is_open()) {
+    return;
+  }
+
+  using exact_attribution::Event;
+  std::vector<Event> events;
+  int detected = 0;
+  int hallucinated = 0;
+  int missed = 0;
+
+  for (const auto& [timestamp, associations] : dsg_to_gt_.associations) {
+    std::unordered_set<NodeId> visited;
+    for (const auto& [pred_id, gt_id] : associations) {
+      if (config.compensate_missegmentation && visited.count(gt_id)) {
+        continue;
+      }
+      visited.emplace(gt_id);
+      const double distance = dsg_to_gt_.association_distances.at(timestamp).at(pred_id);
+      events.push_back(Event{"dynamic_object",
+                             name,
+                             row_ordinal,
+                             query_time,
+                             timestamp,
+                             pred_id,
+                             gt_id,
+                             distance,
+                             "TP"});
+      detected++;
+    }
+  }
+  for (const auto& [timestamp, ids] : dsg_to_gt_.failed) {
+    for (const auto& pred_id : ids) {
+      events.push_back(Event{"dynamic_object",
+                             name,
+                             row_ordinal,
+                             query_time,
+                             timestamp,
+                             pred_id,
+                             std::nullopt,
+                             std::nullopt,
+                             "FP"});
+      hallucinated++;
+    }
+  }
+  for (const auto& [timestamp, ids] : gt_to_dsg_.failed) {
+    for (const auto& gt_id : ids) {
+      events.push_back(Event{"dynamic_object",
+                             name,
+                             row_ordinal,
+                             query_time,
+                             timestamp,
+                             std::nullopt,
+                             gt_id,
+                             std::nullopt,
+                             "FN"});
+      missed++;
+    }
+  }
+
+  CHECK_EQ(detected, detections.num_detected);
+  CHECK_EQ(hallucinated, detections.num_hallucinated);
+  CHECK_EQ(missed, detections.num_missed);
+  exact_attribution::writeEvents(attribution_file_, std::move(events));
+}
+
