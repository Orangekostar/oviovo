+void ObjectEvaluator::writeExactAttribution(const std::string& name,
+                                            const uint64_t query_time,
+                                            const ChangeMetrics& changes,
+                                            const DetectionMetrics& detections) {
+  const size_t row_ordinal = metric_row_ordinal_++;
+  if (!attribution_file_.is_open()) {
+    return;
+  }
+
+  using exact_attribution::Event;
+  std::vector<Event> events;
+  const auto distance_for = [](const RawMetrics& metrics,
+                               const NodeId from) -> std::optional<double> {
+    const auto it = metrics.association_distances.find(from);
+    return it == metrics.association_distances.end()
+               ? std::nullopt
+               : std::optional<double>(it->second);
+  };
+  const auto add_event = [&](const std::string& metric_type,
+                             const std::string& status,
+                             const std::optional<NodeId> pred_id,
+                             const std::optional<NodeId> gt_id,
+                             const std::optional<double> distance) {
+    events.push_back(Event{metric_type,
+                           name,
+                           row_ordinal,
+                           query_time,
+                           query_time,
+                           pred_id,
+                           gt_id,
+                           distance,
+                           status});
+  };
+
+  std::unordered_set<NodeId> visited;
+  for (const auto& [pred_id, gt_id] : dsg_to_gt_.associations) {
+    if (config.compensate_missegmentation && visited.count(gt_id)) {
+      continue;
+    }
+    visited.emplace(gt_id);
+    const auto& pred = eval_dsg_.objects.at(pred_id);
+    const auto& gt = gt_dsg_.objects.at(gt_id);
+    if (isPresent(pred, query_time)) {
+      add_event("object",
+                isPresent(gt, query_time) ? "TP" : "FP",
+                pred_id,
+                gt_id,
+                distance_for(dsg_to_gt_, pred_id));
+    }
+  }
+  for (const auto& pred_id : dsg_to_gt_.failed) {
+    if (isPresent(eval_dsg_.objects.at(pred_id), query_time)) {
+      add_event("object", "FP", pred_id, std::nullopt, std::nullopt);
+    }
+  }
+
+  visited.clear();
+  for (const auto& [gt_id, pred_id] : gt_to_dsg_.associations) {
+    if (config.compensate_missegmentation && visited.count(pred_id)) {
+      continue;
+    }
+    visited.emplace(pred_id);
+    const auto& gt = gt_dsg_.objects.at(gt_id);
+    const auto& pred = eval_dsg_.objects.at(pred_id);
+    if (isPresent(gt, query_time) && !isPresent(pred, query_time)) {
+      add_event("object", "FN", pred_id, gt_id, distance_for(gt_to_dsg_, gt_id));
+    }
+  }
+  for (const auto& gt_id : gt_to_dsg_.failed) {
+    if (isPresent(gt_dsg_.objects.at(gt_id), query_time)) {
+      add_event("object", "FN", std::nullopt, gt_id, std::nullopt);
+    }
+  }
+
+  visited.clear();
+  for (const auto& [pred_id, gt_id] : dsg_to_gt_.associations) {
+    if (config.compensate_missegmentation && visited.count(gt_id)) {
+      continue;
+    }
+    visited.emplace(gt_id);
+    const auto& pred = eval_dsg_.objects.at(pred_id);
+    const auto& gt = gt_dsg_.objects.at(gt_id);
+    const auto distance = distance_for(dsg_to_gt_, pred_id);
+    if (hasAppeared(pred, query_time)) {
+      add_event("change_appeared",
+                hasAppeared(gt, query_time) ? "TP" : "FP",
+                pred_id,
+                gt_id,
+                distance);
+    }
+    if (hasDisappeared(pred, query_time)) {
+      add_event("change_disappeared",
+                hasDisappeared(gt, query_time) ? "TP" : "FP",
+                pred_id,
+                gt_id,
+                distance);
+    }
+  }
+  for (const auto& pred_id : dsg_to_gt_.failed) {
+    const auto& pred = eval_dsg_.objects.at(pred_id);
+    if (hasAppeared(pred, query_time)) {
+      add_event("change_appeared", "FP", pred_id, std::nullopt, std::nullopt);
+    }
+    if (hasDisappeared(pred, query_time)) {
+      add_event("change_disappeared", "FP", pred_id, std::nullopt, std::nullopt);
+    }
+  }
+
+  visited.clear();
+  for (const auto& [gt_id, pred_id] : gt_to_dsg_.associations) {
+    if (config.compensate_missegmentation && visited.count(pred_id)) {
+      continue;
+    }
+    visited.emplace(pred_id);
+    const auto& gt = gt_dsg_.objects.at(gt_id);
+    const auto& pred = eval_dsg_.objects.at(pred_id);
+    const auto distance = distance_for(gt_to_dsg_, gt_id);
+    if (hasAppeared(gt, query_time) && !hasAppeared(pred, query_time)) {
+      add_event("change_appeared", "FN", pred_id, gt_id, distance);
+    }
+    if (hasDisappeared(gt, query_time) && !hasDisappeared(pred, query_time)) {
+      add_event("change_disappeared", "FN", pred_id, gt_id, distance);
+    }
+  }
+  for (const auto& gt_id : gt_to_dsg_.failed) {
+    const auto& gt = gt_dsg_.objects.at(gt_id);
+    if (hasAppeared(gt, query_time)) {
+      add_event("change_appeared", "FN", std::nullopt, gt_id, std::nullopt);
+    }
+    if (hasDisappeared(gt, query_time)) {
+      add_event("change_disappeared", "FN", std::nullopt, gt_id, std::nullopt);
+    }
+  }
+
+  const auto count = [&](const std::string& metric_type, const std::string& status) {
+    return std::count_if(events.begin(), events.end(), [&](const Event& event) {
+      return event.metric_type == metric_type && event.status == status;
+    });
+  };
+  CHECK_EQ(count("object", "TP"), detections.num_detected);
+  CHECK_EQ(count("object", "FP"), detections.num_hallucinated);
+  CHECK_EQ(count("object", "FN"), detections.num_missed);
+  CHECK_EQ(count("change_appeared", "TP"), changes.appeared_tp);
+  CHECK_EQ(count("change_appeared", "FP"),
+           changes.appeared_fp + changes.appeared_hallucinated_p);
+  CHECK_EQ(count("change_appeared", "FN"), changes.appeared_fn + changes.appeared_missed_p);
+  CHECK_EQ(count("change_disappeared", "TP"), changes.disappeared_tp);
+  CHECK_EQ(count("change_disappeared", "FP"),
+           changes.disappeared_fp + changes.disappeared_hallucinated_p);
+  CHECK_EQ(count("change_disappeared", "FN"),
+           changes.disappeared_fn + changes.disappeared_missed_p);
+  exact_attribution::writeEvents(attribution_file_, std::move(events));
+}
