+def file_sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def compose_instance_id_mask(pred_masks, pred_scores, confidence_threshold):
+    selected = pred_scores >= confidence_threshold
+    selected_scores = pred_scores[selected].detach().cpu().numpy()
+    selected_masks = pred_masks[selected].detach().cpu().numpy().astype(bool)
+    if selected_masks.shape[0] > np.iinfo(np.uint8).max:
+        raise ValueError("CropFormer returned more than 255 selected masks")
+    mask_id = np.zeros(pred_masks.shape[-2:], dtype=np.uint8)
+    for index in np.argsort(selected_scores, kind="stable"):
+        mask_id[selected_masks[index]] = int(index) + 1
+    return mask_id
+
+
+def mask_diagnostics(mask_id):
+    ids, counts = np.unique(mask_id, return_counts=True)
+    positive_counts = counts[ids > 0]
+    return {
+        "dtype": str(mask_id.dtype),
+        "shape": list(mask_id.shape),
+        "instance_ids": ids[ids > 0].astype(int).tolist(),
+        "instance_count": int(np.count_nonzero(ids > 0)),
+        "foreground_ratio": float(positive_counts.sum() / mask_id.size),
+        "largest_instance_ratio": (
+            float(positive_counts.max() / mask_id.size)
+            if positive_counts.size
+            else 0.0
+        ),
+    }
+
+
