+void LabelTsdfConfidenceIntegrator::beginRecoveryAssociation(
+    const std::vector<std::tuple<InstanceLabel, std::string, InstanceLabel>>& actions) {
+  CHECK(recovery_association_);
+  backbone_prior_owners_.clear();
+  backbone_planned_owners_.clear();
+  backbone_fresh_groups_.clear();
+  backbone_alias_tokens_.clear();
+  backbone_allocated_owners_.clear();
+  backbone_candidate_vetoes_ = 0;
+  backbone_alias_vetoes_ = 0;
+  recovery_actions_.clear();
+  recovery_realized_assignments_.clear();
+  recovery_reserved_owners_.clear();
+  recovery_mixed_fallback_candidates_ = 0;
+  std::set<InstanceLabel> active;
+  for (const auto& entry : semantic_instance_label_fusion_ptr_->label_frames_count_) {
+    const InstanceLabel owner = semantic_instance_label_fusion_ptr_->getInstanceLabel(entry.first, 0.0f);
+    backbone_prior_owners_.emplace(entry.first, owner);
+    if (owner != BackgroundLabel) active.insert(owner);
+  }
+  for (const auto& item : actions) {
+    const InstanceLabel group = std::get<0>(item);
+    const std::string action = std::get<1>(item);
+    InstanceLabel owner = std::get<2>(item);
+    CHECK_NE(group, BackgroundLabel);
+    CHECK(recovery_actions_.emplace(group, action).second);
+    if (action == "USE_NATIVE") {
+      CHECK_EQ(owner, BackgroundLabel);
+      continue;
+    }
+    if (action == "ASSIGN_EXISTING") {
+      CHECK_NE(owner, BackgroundLabel);
+      CHECK(active.count(owner));
+    } else {
+      CHECK_EQ(action, "CREATE_NEW");
+      CHECK_EQ(owner, BackgroundLabel);
+      owner = getFreshInstance();
+      backbone_allocated_owners_.push_back(owner);
+    }
+    backbone_planned_owners_.emplace(group, owner);
+    recovery_reserved_owners_.insert(owner);
+  }
+}
