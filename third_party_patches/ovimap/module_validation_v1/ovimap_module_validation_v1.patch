+pybind11::dict GlobalSegmentMap_py::exportStudyFrameState()
+{
+    pybind11::dict state;
+    pybind11::list segments;
+    pybind11::list aliases;
+    pybind11::list label_instances;
+    pybind11::dict association;
+
+    std::lock_guard<std::mutex> label_tsdf_layers_lock(
+        label_tsdf_layers_mutex_);
+
+    auto *fusion = integrator_->semantic_instance_label_fusion_ptr_;
+    std::set<Label> registered_labels;
+    for (size_t segment_index = 0;
+         segment_index < segments_to_integrate_.size(); ++segment_index) {
+        const Segment *segment = segments_to_integrate_.at(segment_index);
+        CHECK_NOTNULL(segment);
+        pybind11::dict row;
+        row["local_index"] = segment_index;
+        row["input_instance_label"] = segment->instance_label_;
+        row["semantic_label"] = segment->semantic_label_;
+        row["registered_label"] = segment->label_;
+        row["point_count"] = segment->points_C_.size();
+        segments.append(row);
+        registered_labels.emplace(segment->label_);
+    }
+
+    for (const auto &merge : merges_to_publish_) {
+        for (const Label old_label : merge.second) {
+            pybind11::dict row;
+            row["old_label"] = old_label;
+            row["resolved_label"] = merge.first;
+            aliases.append(row);
+            registered_labels.emplace(old_label);
+            registered_labels.emplace(merge.first);
+        }
+    }
+
+    for (const Label segment_label : registered_labels) {
+        pybind11::dict row;
+        row["segment_label"] = segment_label;
+        row["instance_label"] = fusion->getInstanceLabel(segment_label, 0.1f);
+        row["semantic_label"] = fusion->getSemanticLabel(segment_label);
+        label_instances.append(row);
+    }
+
+    association["instance_association"] = inst_association_;
+    association["data_association"] = data_association_;
+    association["segment_graph_confidence"] = seg_graph_confidence_;
+    association["use_instance_label_connect"] = use_inst_label_connect_;
+    association["connection_ratio_threshold"] = connection_ratio_th_;
+    association["label_mapping_count_threshold_factor"] = 0.1f;
+
+    state["integrated_frame_count"] = integrated_frames_count_;
+    state["segments"] = segments;
+    state["aliases"] = aliases;
+    state["label_instances"] = label_instances;
+    state["association"] = association;
+    return state;
+}
+
+
+pybind11::dict GlobalSegmentMap_py::exportStudyTsdfState()
+{
+    std::lock_guard<std::mutex> label_tsdf_layers_lock(label_tsdf_layers_mutex_);
+    auto *layer = map_->getTsdfLayerPtr();
+    BlockIndexList indices;
+    layer->getAllAllocatedBlocks(&indices);
+    std::sort(indices.begin(), indices.end(), [](const BlockIndex &a, const BlockIndex &b) {
+        if (a.x() != b.x()) return a.x() < b.x();
+        if (a.y() != b.y()) return a.y() < b.y();
+        return a.z() < b.z();
+    });
+    const size_t side = layer->voxels_per_side();
+    const size_t voxels_per_block = side * side * side;
+    const pybind11::ssize_t block_count = indices.size();
+    const pybind11::ssize_t voxel_count = indices.size() * voxels_per_block;
+    pybind11::array_t<int32_t> block_indices(std::vector<pybind11::ssize_t>{block_count, 3});
+    pybind11::array_t<float> distance(voxel_count), weight(voxel_count);
+    pybind11::array_t<uint8_t> color(std::vector<pybind11::ssize_t>{voxel_count, 4});
+    auto blocks = block_indices.mutable_unchecked<2>();
+    auto distances = distance.mutable_unchecked<1>();
+    auto weights = weight.mutable_unchecked<1>();
+    auto colors = color.mutable_unchecked<2>();
+    for (pybind11::ssize_t b = 0; b < block_count; ++b) {
+        const auto block = layer->getBlockPtrByIndex(indices[b]);
+        for (int axis = 0; axis < 3; ++axis) blocks(b, axis) = indices[b][axis];
+        for (size_t v = 0; v < voxels_per_block; ++v) {
+            const auto &voxel = block->getVoxelByLinearIndex(v);
+            const pybind11::ssize_t row = b * voxels_per_block + v;
+            distances(row) = voxel.distance;
+            weights(row) = voxel.weight;
+            colors(row, 0) = voxel.color.r;
+            colors(row, 1) = voxel.color.g;
+            colors(row, 2) = voxel.color.b;
+            colors(row, 3) = voxel.color.a;
+        }
+    }
+    pybind11::dict result;
+    result["block_indices"] = block_indices;
+    result["distance"] = distance;
+    result["weight"] = weight;
+    result["color"] = color;
+    result["voxel_size"] = layer->voxel_size();
+    result["voxels_per_side"] = side;
+    return result;
+}
+
+
+pybind11::dict GlobalSegmentMap_py::exportStudySurfaceLabels(
+    pybind11::array_t<float> native_xyz)
+{
+    if (native_xyz.ndim() != 2 || native_xyz.shape(1) != 3) {
+        throw std::invalid_argument("native_xyz must have shape [N, 3]");
+    }
+
+    const pybind11::ssize_t row_count = native_xyz.shape(0);
+    auto xyz = native_xyz.unchecked<2>();
+    pybind11::array_t<uint16_t> segment_labels(row_count);
+    pybind11::array_t<uint16_t> instance_labels(row_count);
+    pybind11::array_t<uint16_t> semantic_labels(row_count);
+    pybind11::array_t<uint8_t> valid(row_count);
+    auto segments = segment_labels.mutable_unchecked<1>();
+    auto instances = instance_labels.mutable_unchecked<1>();
+    auto semantics = semantic_labels.mutable_unchecked<1>();
+    auto validity = valid.mutable_unchecked<1>();
+
+    std::lock_guard<std::mutex> mesh_layer_lock(mesh_layer_mutex_);
+    std::lock_guard<std::mutex> label_tsdf_layers_lock(
+        label_tsdf_layers_mutex_);
+
+    BlockIndexList mesh_indices;
+    mesh_instance_layer_->getAllAllocatedMeshes(&mesh_indices);
+    size_t mesh_vertex_count = 0u;
+    for (const BlockIndex &block_index : mesh_indices) {
+        mesh_vertex_count +=
+            mesh_instance_layer_->getMeshPtrByIndex(block_index)->vertices.size();
+    }
+    if (mesh_vertex_count != static_cast<size_t>(row_count)) {
+        throw std::invalid_argument(
+            "native_xyz rows do not match the generated instance mesh");
+    }
+
+    auto *fusion = integrator_->semantic_instance_label_fusion_ptr_;
+    pybind11::ssize_t row = 0;
+    constexpr float kPlyCoordinateTolerance = 1e-4f;
+    for (const BlockIndex &block_index : mesh_indices) {
+        Mesh::ConstPtr mesh =
+            mesh_instance_layer_->getMeshPtrByIndex(block_index);
+        Block<LabelVoxel>::ConstPtr label_block =
+            integrator_->label_layer_->getBlockPtrByIndex(block_index);
+        if (!mesh->vertices.empty() && !label_block) {
+            throw std::runtime_error(
+                "generated instance mesh has no corresponding label block");
+        }
+        for (const Point &mesh_vertex : mesh->vertices) {
+            const Point supplied_vertex(xyz(row, 0), xyz(row, 1), xyz(row, 2));
+            if ((mesh_vertex - supplied_vertex).cwiseAbs().maxCoeff() >
+                kPlyCoordinateTolerance) {
+                throw std::invalid_argument(
+                    "native_xyz rows do not match the generated instance mesh");
+            }
+
+            const VoxelIndex voxel_index =
+                label_block->computeVoxelIndexFromCoordinates(mesh_vertex);
+            const LabelVoxel *voxel = nullptr;
+            if (label_block->isValidVoxelIndex(voxel_index)) {
+                voxel = &label_block->getVoxelByVoxelIndex(voxel_index);
+            } else {
+                Block<LabelVoxel>::ConstPtr neighbor_block =
+                    integrator_->label_layer_->getBlockPtrByCoordinates(mesh_vertex);
+                if (neighbor_block) {
+                    voxel = &neighbor_block->getVoxelByCoordinates(mesh_vertex);
+                }
+            }
+
+            const Label segment_label =
+                voxel == nullptr ? BackgroundLabel : voxel->label;
+            segments(row) = segment_label;
+            instances(row) = segment_label == BackgroundLabel
+                ? BackgroundLabel
+                : fusion->getInstanceLabel(segment_label, 0.1f);
+            semantics(row) = segment_label == BackgroundLabel
+                ? BackgroundSemLabel
+                : fusion->getSemanticLabel(segment_label);
+            validity(row) = voxel == nullptr ? 0u : 1u;
+            ++row;
+        }
+    }
+
+    pybind11::dict result;
+    result["segment_labels"] = segment_labels;
+    result["instance_labels"] = instance_labels;
+    result["semantic_labels"] = semantic_labels;
+    result["valid"] = valid;
+    result["label_mapping_count_threshold_factor"] = 0.1f;
+    return result;
+}
+
