 """
 View selection strategies for OVI-MAP.
 Decides which views (frames) to keep per instance.
 """
 
 import logging
 import numpy as np
 
 from utils.common_utils import PointCloudProcessor
 
 
+def enumerate_admissible_views(
+    glo_inst_map, inst_seg, depth_scaled, valid_d_mask, pose, points_map,
+    vis_area_thres,
+):
+    """Return all technically admissible current-frame requests without mutation."""
+    candidates = []
+    for glo_inst_id in np.unique(glo_inst_map):
+        if glo_inst_id == 0:
+            continue
+
+        glo_inst_mask = glo_inst_map == glo_inst_id
+        glo_inst_area = int(np.count_nonzero(glo_inst_mask))
+        if glo_inst_area < 0.5 * vis_area_thres:
+            continue
+
+        pano_id_map = inst_seg[glo_inst_mask]
+        if pano_id_map.size == 0:
+            continue
+        pano_ids, pano_id_count = np.unique(pano_id_map, return_counts=True)
+        pano_id = pano_ids[np.argmax(pano_id_count)]
+        pano_mask = inst_seg == pano_id
+        pano_id_area = int(np.count_nonzero(pano_mask))
+        if pano_id_area < vis_area_thres:
+            continue
+
+        inst_d_mask = np.logical_and(glo_inst_mask, valid_d_mask)
+        valid_depth_pixels = int(np.count_nonzero(inst_d_mask))
+        if valid_depth_pixels < 0.1 * vis_area_thres:
+            continue
+
+        y_coords, x_coords = np.nonzero(glo_inst_mask)
+        x1, x2 = int(x_coords.min()), int(x_coords.max())
+        y1, y2 = int(y_coords.min()), int(y_coords.max())
+        if x2 <= x1 or y2 <= y1:
+            continue
+
+        inst_points = points_map[inst_d_mask].astype(np.float32).reshape(-1, 3)
+        inst_points = inst_points @ pose[:3, :3].T + pose[:3, 3:4].T
+        union_mask = np.logical_or(pano_mask, glo_inst_mask)
+        candidates.append({
+            'glo_inst_id': int(glo_inst_id),
+            'glo_inst_mask': glo_inst_mask,
+            'glo_inst_area': glo_inst_area,
+            'pano_id': int(pano_id),
+            'pano_mask': pano_mask,
+            'pano_id_area': pano_id_area,
+            'overlap_area': int(np.max(pano_id_count)),
+            'overlap_mask': np.logical_and(glo_inst_mask, pano_mask),
+            'union_mask': union_mask,
+            'bbox_xyxy_native': (x1, y1, x2, y2),
+            'valid_depth_pixels': valid_depth_pixels,
+            'depth_valid_fraction': valid_depth_pixels / float(glo_inst_area),
+            'world_centroid': np.mean(inst_points, axis=0).astype(np.float32),
+        })
+    return candidates
+
