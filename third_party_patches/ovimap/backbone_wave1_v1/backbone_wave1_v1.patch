+void LabelTsdfConfidenceIntegrator::beginBackboneAssociation(
+    const std::vector<std::pair<InstanceLabel, InstanceLabel>>& plans) {
+  CHECK(backbone_object_association_);
+  backbone_prior_owners_.clear();
+  backbone_planned_owners_.clear();
+  backbone_fresh_groups_.clear();
+  backbone_alias_tokens_.clear();
+  backbone_allocated_owners_.clear();
+  backbone_candidate_vetoes_ = 0;
+  backbone_alias_vetoes_ = 0;
+  for (const auto& entry : semantic_instance_label_fusion_ptr_->label_frames_count_) {
+    InstanceLabel owner = semantic_instance_label_fusion_ptr_->getInstanceLabel(entry.first, 0.0f);
+    backbone_prior_owners_.emplace(entry.first, owner);
+    if (owner != BackgroundLabel) backbone_alias_tokens_[entry.first].insert(owner);
+  }
+  for (const auto& plan : plans) {
+    CHECK_NE(plan.first, BackgroundLabel);
+    CHECK(backbone_planned_owners_.find(plan.first) == backbone_planned_owners_.end());
+    InstanceLabel owner = plan.second;
+    if (owner == BackgroundLabel) {
+      owner = getFreshInstance();
+      backbone_allocated_owners_.push_back(owner);
+    }
+    backbone_planned_owners_.emplace(plan.first, owner);
+  }
+}
+
+bool LabelTsdfConfidenceIntegrator::backboneCandidateAllowed(const Segment* segment, Label label) {
+  if (!backbone_object_association_ || segment->instance_label_ == BackgroundLabel) return true;
+  const auto planned = backbone_planned_owners_.find(segment->instance_label_);
+  CHECK(planned != backbone_planned_owners_.end());
+  const auto fresh = backbone_fresh_groups_.find(label);
+  if (fresh != backbone_fresh_groups_.end()) return fresh->second == segment->instance_label_;
+  const auto prior = backbone_prior_owners_.find(label);
+  const bool allowed = prior != backbone_prior_owners_.end() && prior->second == planned->second;
+  if (allowed) backbone_alias_tokens_[label].insert(planned->second);
+  return allowed;
+}
+
+void LabelTsdfConfidenceIntegrator::tagBackboneFreshLabel(const Segment* segment, Label label) {
+  if (!backbone_object_association_) return;
+  backbone_fresh_groups_[label] = segment->instance_label_;
+  if (segment->instance_label_ != BackgroundLabel) {
+    const auto planned = backbone_planned_owners_.find(segment->instance_label_);
+    CHECK(planned != backbone_planned_owners_.end());
+    backbone_alias_tokens_[label].insert(planned->second);
+  }
+}
+
+bool LabelTsdfConfidenceIntegrator::backboneAliasCompatible(Label first, Label second) const {
+  if (!backbone_object_association_) return true;
+  std::set<InstanceLabel> tokens;
+  for (const Label label : {first, second}) {
+    const auto it = backbone_alias_tokens_.find(label);
+    if (it != backbone_alias_tokens_.end()) tokens.insert(it->second.begin(), it->second.end());
+  }
+  return tokens.size() <= 1;
+}
+
+void LabelTsdfConfidenceIntegrator::aggregateBackboneAlias(Label retained, Label removed) {
+  if (!backbone_object_association_) return;
+  const auto it = backbone_alias_tokens_.find(removed);
+  if (it != backbone_alias_tokens_.end())
+    backbone_alias_tokens_[retained].insert(it->second.begin(), it->second.end());
+  backbone_alias_tokens_.erase(removed);
+}
+
+std::map<std::string, double> LabelTsdfConfidenceIntegrator::backboneStateSummary() const {
+  std::map<std::string, double> state;
+  state["highest_label"] = *highest_label_ptr_;
+  state["highest_instance"] = *highest_instance_ptr_;
+  state["known_labels"] = semantic_instance_label_fusion_ptr_->label_frames_count_.size();
+  state["allocated_tsdf_blocks"] = layer_->getNumberOfAllocatedBlocks();
+  state["allocated_label_blocks"] = label_layer_->getNumberOfAllocatedBlocks();
+  state["label_frame_count_sum"] = 0;
+  state["class_instance_count_sum"] = 0;
+  state["pairwise_confidence_sum"] = 0;
+  for (const auto& row : semantic_instance_label_fusion_ptr_->label_frames_count_)
+    state["label_frame_count_sum"] += row.second;
+  for (const auto& label : semantic_instance_label_fusion_ptr_->label_class_instance_count_)
+    for (const auto& semantic : label.second)
+      for (const auto& owner : semantic.second)
+        state["class_instance_count_sum"] += owner.second;
+  for (const auto& first : pairwise_confidence_)
+    for (const auto& second : first.second) state["pairwise_confidence_sum"] += second.second;
+  return state;
+}
+
+void LabelTsdfConfidenceIntegrator::exportAssociationProbe(
+    const Transformation& pose, const cv::Mat& depth, const CameraRayGenerator* rays,
+    cv::Mat* labels, cv::Mat* owners, cv::Mat* hit_depth, cv::Mat* validity) const {
+  CHECK_NOTNULL(rays);
+  const Transformation inverse = pose.inverse();
+  for (int row = 0; row < depth.rows; ++row) {
+    for (int col = 0; col < depth.cols; ++col) {
+      const float z = depth.at<float>(row, col);
+      if (!std::isfinite(z) || z <= 0.f || z >= 50.f) continue;
+      const float near_z = std::max(z - .2f, rays->getRangeMin());
+      const float far_z = std::min(z + .2f, rays->getRangeMax());
+      if (near_z <= 0.f || near_z > far_z) continue;
+      const cv::Vec3f near_ray = rays->getRayWithDepth(row, col, near_z);
+      const cv::Vec3f far_ray = rays->getRayWithDepth(row, col, far_z);
+      const Point near_G = pose * Point(near_ray[0], near_ray[1], near_ray[2]);
+      const Point far_G = pose * Point(far_ray[0], far_ray[1], far_ray[2]);
+      RayCaster caster(near_G * voxel_size_inv_, far_G * voxel_size_inv_);
+      GlobalIndex index;
+      while (caster.nextRayIndex(&index)) {
+        const LabelVoxel* label = label_layer_->getVoxelPtrByGlobalIndex(index);
+        const TsdfVoxel* tsdf = layer_->getVoxelPtrByGlobalIndex(index);
+        if (label == nullptr || tsdf == nullptr || label->label == 0 ||
+            label->label_confidence < .5f || tsdf->weight <= 0.f ||
+            std::abs(tsdf->distance) > 2.f * voxel_size_) continue;
+        const Point center_G = (index.cast<FloatingPoint>().array() + .5f).matrix() * voxel_size_;
+        const float camera_z = (inverse * center_G).z();
+        if (camera_z <= 0.f || std::abs(camera_z - z) > .03f + .01f * z) continue;
+        const InstanceLabel owner = semantic_instance_label_fusion_ptr_->getInstanceLabel(label->label, 0.0f);
+        labels->at<uint16_t>(row, col) = label->label;
+        owners->at<uint16_t>(row, col) = owner;
+        hit_depth->at<float>(row, col) = camera_z;
+        validity->at<uint8_t>(row, col) = 1;
+        break;
+      }
+    }
+  }
+}
