+pybind11::dict GlobalSegmentMap_py::exportAssociationProbe(pybind11::array &pose, pybind11::array &depth)
+{
+    std::lock_guard<std::mutex> lock(label_tsdf_layers_mutex_);
+    CHECK(segments_to_integrate_.empty());
+    CHECK_NOTNULL(cam_ray_generator_);
+    const cv::Mat pose_mat = cvnp::nparray_to_mat(pose);
+    Eigen::Matrix<float, 4, 4> pose_eigen;
+    cv::cv2eigen(pose_mat, pose_eigen);
+    const Transformation transform(pose_eigen);
+    const cv::Mat depth_mat = cvnp::nparray_to_mat(depth);
+    CHECK_EQ(depth_mat.type(), CV_32F);
+    CHECK_EQ(depth_mat.rows, cam_ray_generator_->img_height_);
+    CHECK_EQ(depth_mat.cols, cam_ray_generator_->img_width_);
+    cv::Mat labels(depth_mat.size(), CV_16U, cv::Scalar(0));
+    cv::Mat owners(depth_mat.size(), CV_16U, cv::Scalar(0));
+    cv::Mat hit_depth(depth_mat.size(), CV_32F, cv::Scalar(0));
+    cv::Mat validity(depth_mat.size(), CV_8U, cv::Scalar(0));
+    const auto before = integrator_->backboneStateSummary();
+    integrator_->exportAssociationProbe(transform, depth_mat, cam_ray_generator_,
+                                        &labels, &owners, &hit_depth, &validity);
+    const auto after = integrator_->backboneStateSummary();
+    CHECK(before == after);
+    pybind11::dict result;
+    result["prior_label"] = cvnp::mat_to_nparray(labels.clone(), false);
+    result["prior_owner"] = cvnp::mat_to_nparray(owners.clone(), false);
+    result["hit_depth"] = cvnp::mat_to_nparray(hit_depth.clone(), false);
+    result["validity"] = cvnp::mat_to_nparray(validity.clone(), false);
+    result["state_before"] = before;
+    result["state_after"] = after;
+    return result;
+}
